# Operations backend (/admin/operations, /api/operations/*). Unset = fail closed (writes refused).
# database: Neon operations_* tables + private object storage (required on Vercel).
# file: isolated local tests only, needs OPERATIONS_DATA_DIR; refused on Vercel.
OPERATIONS_PERSISTENCE_MODE=database
OPERATIONS_CRON_TOKEN=replace-with-random-worker-token
# Keep unset/false until publishing is explicitly approved.
OPERATIONS_LIVE_PUBLISH_ENABLED=false

# Private object storage for operations images (Cloudflare R2, S3-compatible). Bucket stays private.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-bucket-scoped-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-bucket-scoped-secret
R2_BUCKET_NAME=replace-with-private-bucket-name

# Instagram Login token store: unset/"database" = encrypted row in Neon (default); file:<path> for local tests only.
# INSTAGRAM_LOGIN_TOKEN_STORE=database
