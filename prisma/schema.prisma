generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CharterQuote {
  id                 String    @id @default(cuid())
  lineUserId         String    @map("line_user_id")
  lineName           String?   @map("line_name")
  tripDate           String?   @map("trip_date")
  passengerCount     Int?      @map("passenger_count")
  pickup             String?
  destination        String?
  remark             String?
  recommendedVehicle String?   @map("recommended_vehicle")
  quoteOptions       Json?     @map("quote_options")
  quoteDraftText     String?   @map("quote_draft_text")
  quoteStatus        String    @default("DRAFT") @map("quote_status")
  sentAt             DateTime? @map("sent_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@map("charter_quotes")
}

model AiConversation {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now()) @map("created_at")
  sessionId      String?  @map("session_id")
  source         String
  userId         String?  @map("user_id")
  query          String
  intent         String
  reply          String
  route          String?
  peopleCount    Int?     @map("people_count")
  luggageCount   Int?     @map("luggage_count")
  estimatedPrice Int?     @map("estimated_price")
  status         String   @default("answered")

  @@index([createdAt])
  @@index([source])
  @@index([intent])
  @@index([route])
  @@map("ai_conversations")
}

model LineSession {
  userId    String   @id @map("user_id")
  state     String
  draftJson Json?    @map("draft_json")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("line_sessions")
}

model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  content     String
  excerpt     String?
  category    String
  tags        String[]
  location    String?
  seoJson     Json?     @map("seo_json")
  schemaJson  Json?     @map("schema_json")
  fbPostId    String?   @unique @map("fb_post_id")
  status      String    @default("draft")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("articles")
}

model Vehicle {
  id        String   @id @default(cuid())
  fleetId   String?  @map("fleet_id")
  brand     String
  model     String
  slug      String   @unique
  seatCount Int?     @map("seat_count")
  features  String[]
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("vehicles")
}

model Inquiry {
  id               String    @id @default(cuid())
  agencyId         String?   @map("agency_id")
  customerName     String    @map("customer_name")
  phone            String
  lineId           String?   @map("line_id")
  email            String?
  tripType         String    @map("trip_type")
  startDate        DateTime? @map("start_date")
  pickupLocation   String?   @map("pickup_location")
  destination      String?
  passengerCount   Int       @map("passenger_count")
  preferredVehicle String[]  @map("preferred_vehicle")
  specialRequests  String?   @map("special_requests")
  source           String?
  sourcePage       String?   @map("source_page")
  referer          String?
  utmSource        String?   @map("utm_source")
  utmMedium        String?   @map("utm_medium")
  utmCampaign      String?   @map("utm_campaign")
  utmTerm          String?   @map("utm_term")
  utmContent       String?   @map("utm_content")
  keyword          String?
  status           String    @default("New")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("inquiries")
}

model LineUser {
  id                String   @id @default(cuid())
  lineUid           String   @unique @map("line_uid")
  name              String?
  phone             String?
  email             String?
  memberLevel       String?  @map("member_level")
  tags              String[]
  inquiryHistory    Json?    @map("inquiry_history")
  quoteHistory      Json?    @map("quote_history")
  orderHistory      Json?    @map("order_history")
  tripHistory       Json?    @map("trip_history")
  couponHistory     Json?    @map("coupon_history")
  repurchaseHistory Json?    @map("repurchase_history")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("line_users")
}

model FbImportLog {
  id         String   @id @default(cuid())
  fbPostId   String   @unique @map("fb_post_id")
  source     String
  title      String
  status     String
  payload    Json
  importedAt DateTime @default(now()) @map("imported_at")

  @@map("fb_import_logs")
}

model Supplier {
  id        String   @id @default(cuid())
  type      String
  name      String
  contact   String?
  region    String?
  tags      String[]
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("suppliers")
}

model ContentDraft {
  id            String   @id @default(cuid())
  tripTitle     String   @map("trip_title")
  inputJson     Json     @map("input_json")
  outputJson    Json     @map("output_json")
  imageUrls     String[] @map("image_urls")
  coverImageUrl String?  @map("cover_image_url")
  status        String   @default("draft")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("content_drafts")
}

// 「已授權社團成員」白名單，老闆自行新增/移除，不需要工程師介入。
// 名單內成員的社團貼文視同官方素材可較大幅度參考改寫；不在名單內的視為
// 「僅供選題參考」，見 ContentSyncItem.sourceType。
model AuthorizedGroupMember {
  id           String   @id @default(cuid())
  displayName  String   @map("display_name")
  fbIdentifier String?  @map("fb_identifier")
  note         String?
  addedAt      DateTime @default(now()) @map("added_at")

  @@map("authorized_group_members")
}

// 每週社群內容同步彙整清單的單一項目（一則貼文）。
// sourceType 決定這則貼文在生成草稿時可以被怎麼使用：
//   page_official    粉專「小羽旅遊趣」官方貼文，可大幅參考改寫
//   group_official   社團內老闆／小羽帳號本人發的貼文，視同官方素材
//   group_whitelist  社團內白名單成員（AuthorizedGroupMember）發的貼文，視同官方素材
//   group_other      社團內其他成員發的貼文，僅供選題參考，不得照抄文字／照片
//   manual           老闆手動提交（例如社團貼文轉貼/截圖，Graph API 讀不到時的備援）
model ContentSyncItem {
  id              String    @id @default(cuid())
  sourcePostId    String?   @unique @map("source_post_id")
  sourceType      String    @map("source_type")
  authorName      String?   @map("author_name")
  summary         String
  postUrl         String?   @map("post_url")
  postedAt        DateTime? @map("posted_at")
  batchLabel      String    @map("batch_label")
  rawPayload      Json?     @map("raw_payload")
  selected        Boolean   @default(false)
  status          String    @default("pending")
  contentDraftId  String?   @map("content_draft_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([batchLabel])
  @@index([sourceType])
  @@map("content_sync_items")
}

// 首頁「這裡真好玩」公開展示卡片。老闆在 /admin/content-sync 對某則
// ContentSyncItem 按「確認上首頁」時建立，直接以 published 狀態寫入——
// 這個點擊動作本身就同時代表內容與版權都已經過老闆確認，不再另外審核。
// 跟 ContentSyncItem 的「生成草稿」流程完全獨立，不共用狀態欄位。
model FeaturedSpot {
  id            String   @id @default(cuid())
  title         String
  description   String
  photoUrl      String?  @map("photo_url")
  photoUrls     String[] @default([]) @map("photo_urls")
  sourceUrl     String?  @map("source_url")
  sourceItemId  String?  @map("source_item_id")
  postedAt      DateTime? @map("posted_at")
  status        String   @default("draft")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("featured_spots")
}
