export const bookingResultSchema: z.ZodType;
export const errorSchema: z.ZodType;
export const inputSchemas: Record<Operation, z.ZodType<TripInput | BookingInput | StatusInput>>;
export const outputSchemas: Record<Operation, z.ZodType>;
export function taipeiDate(now?: Date): string;
export function validateInput(name: Operation, input: unknown, now?: Date, allowPastDate?: boolean): { success: true; data: TripInput | BookingInput | StatusInput } | { success: false; error: { issues: Array<{ path: PropertyKey[]; message: string }> } };
