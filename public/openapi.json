{
  "openapi": "3.1.0",
  "info": {
    "title": "Fuyun Travel AI API",
    "version": "1.0.0",
    "description": "Owner-issued bearer key required. Shared limits per key: 30 requests/minute, 1,000/Taipei calendar day; 20 new booking requests/hour. No automatic confirmation or payment. Dates use Asia/Taipei."
  },
  "servers": [
    {
      "url": "https://fuyuntravel.com"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/public/v1/quote": {
      "post": {
        "operationId": "get_quote",
        "description": "Indicative customerRange price only. Driver fee is separate. Staff confirm national holidays, taxes, vehicle and final fare.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/get_quoteInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success; human confirmation required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/get_quoteResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input; issues identify field paths",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or disabled key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Shared rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds until the exhausted shared window resets.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/public/v1/availability": {
      "post": {
        "operationId": "check_availability",
        "description": "Always pending human confirmation. Does not query availability or reserve a vehicle.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/check_availabilityInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success; human confirmation required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/check_availabilityResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input; issues identify field paths",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or disabled key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Shared rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds until the exhausted shared window resets.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/public/v1/bookings": {
      "post": {
        "operationId": "create_booking",
        "description": "Creates a pending-review request only. No payment or confirmed sale. TEST- key names produce FY-TEST- numbers. Same API key and Idempotency-Key replay the same request for 24 hours; a new request may be created after expiry.",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "description": "Same API key and same header return the same request for 24 hours. Replays return HTTP 200 with replay=true.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[!-~]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/create_bookingInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success; human confirmation required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/create_bookingResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input; issues identify field paths",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or disabled key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Shared rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds until the exhausted shared window resets.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "fyk_ + 32 random bytes encoded as base64url",
        "description": "Obtain a key from the owner. Keys are never pre-provisioned."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "pattern": "^[^\\u0000]*$",
            "description": "Safe public error message without credentials or private upstream details."
          },
          "issues": {
            "description": "Field validation issues when available.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[^\\u0000]*$"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  },
                  "description": "Path to the invalid input field, including nested indexes."
                },
                "message": {
                  "type": "string",
                  "pattern": "^[^\\u0000]*$",
                  "description": "Validation issue for the indicated field."
                }
              },
              "required": [
                "path",
                "message"
              ]
            }
          }
        },
        "required": [
          "error"
        ]
      },
      "get_quoteInput": {
        "type": "object",
        "properties": {
          "pickup": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[^\\u0000]*$",
            "description": "Pickup address or departure location."
          },
          "destination": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[^\\u0000]*$",
            "description": "Destination address or route name."
          },
          "date": {
            "type": "string",
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              },
              {
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            ],
            "description": "Calendar date YYYY-MM-DD, today or later in Asia/Taipei."
          },
          "end_date": {
            "description": "Optional inclusive trip end date; must be on or after date.",
            "type": "string",
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              },
              {
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            ]
          },
          "passenger_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60,
            "description": "Total passengers including adults and children, 1–60."
          },
          "vehicle": {
            "description": "Vehicle preference, e.g. 大巴, 中巴, 九人座. Omit to infer using existing quote rules.",
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[^\\u0000]*$"
          },
          "notes": {
            "description": "Optional trip requirements; never an authoritative price.",
            "type": "string",
            "maxLength": 2000,
            "pattern": "^[^\\u0000]*$"
          }
        },
        "required": [
          "pickup",
          "destination",
          "date",
          "passenger_count"
        ],
        "additionalProperties": false,
        "description": "Reference quote request; staff must confirm all prices."
      },
      "get_quoteResult": {
        "type": "object",
        "properties": {
          "price_available": {
            "type": "boolean",
            "description": "Whether an approved reference range is available."
          },
          "low": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ],
            "description": "Reference lower price in TWD; null when staff pricing is needed."
          },
          "high": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ],
            "description": "Reference upper price in TWD; null when staff pricing is needed."
          },
          "currency": {
            "type": "string",
            "const": "TWD",
            "description": "Currency: New Taiwan dollars."
          },
          "day_type": {
            "type": "string",
            "enum": [
              "weekday",
              "holiday"
            ],
            "description": "Existing weekday/holiday classification; staff verify public holidays."
          },
          "vehicle": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[^\\u0000]*$"
              },
              {
                "type": "null"
              }
            ],
            "description": "Recommended vehicle label, if known."
          },
          "route": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[^\\u0000]*$"
              },
              {
                "type": "null"
              }
            ],
            "description": "Matched route label, if known."
          },
          "driver_fee": {
            "type": "object",
            "properties": {
              "included": {
                "type": "boolean",
                "const": false,
                "description": "Driver service fee is always charged separately."
              },
              "weekday": {
                "type": "number",
                "const": 2500,
                "description": "Weekday reference driver service fee per day in TWD."
              },
              "holiday": {
                "type": "number",
                "const": 3500,
                "description": "Holiday reference driver service fee per day in TWD."
              },
              "amount": {
                "description": "Applicable daily driver fee, or null for multi-day verification.",
                "type": [
                  "number",
                  "null"
                ]
              },
              "unit": {
                "type": "string",
                "const": "per_day",
                "description": "Driver fee unit, per day."
              },
              "note": {
                "type": "string",
                "pattern": "^[^\\u0000]*$",
                "description": "Staff confirmation and driver service fee terms."
              }
            },
            "required": [
              "included",
              "weekday",
              "holiday",
              "amount",
              "unit",
              "note"
            ],
            "additionalProperties": false,
            "description": "Separate driver service fee details; never included in the reference range."
          },
          "tax_note": {
            "type": "string",
            "pattern": "^[^\\u0000]*$",
            "description": "Tax and vehicle-specific terms requiring staff confirmation."
          },
          "requires_human_confirmation": {
            "type": "boolean",
            "const": true,
            "description": "Always true; this is not a formal quote or reservation."
          },
          "note": {
            "type": "string",
            "pattern": "^[^\\u0000]*$",
            "description": "Traditional Chinese reference-price disclaimer."
          },
          "note_en": {
            "type": "string",
            "pattern": "^[^\\u0000]*$",
            "description": "English reference-price disclaimer."
          },
          "pricing_note": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[^\\u0000]*$"
              },
              {
                "type": "null"
              }
            ],
            "description": "Existing price-range explanation, surcharges or staff-pricing notice."
          }
        },
        "required": [
          "price_available",
          "low",
          "high",
          "currency",
          "day_type",
          "vehicle",
          "route",
          "driver_fee",
          "tax_note",
          "requires_human_confirmation",
          "note",
          "note_en",
          "pricing_note"
        ],
        "additionalProperties": false,
        "description": "Unchanged indicative customerRange quote result."
      },
      "check_availabilityInput": {
        "type": "object",
        "properties": {
          "pickup": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[^\\u0000]*$",
            "description": "Pickup address or departure location."
          },
          "destination": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[^\\u0000]*$",
            "description": "Destination address or route name."
          },
          "date": {
            "type": "string",
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              },
              {
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            ],
            "description": "Calendar date YYYY-MM-DD, today or later in Asia/Taipei."
          },
          "end_date": {
            "description": "Optional inclusive trip end date; must be on or after date.",
            "type": "string",
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              },
              {
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            ]
          },
          "passenger_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60,
            "description": "Total passengers including adults and children, 1–60."
          },
          "vehicle": {
            "description": "Vehicle preference, e.g. 大巴, 中巴, 九人座. Omit to infer using existing quote rules.",
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[^\\u0000]*$"
          },
          "notes": {
            "description": "Optional trip requirements; never an authoritative price.",
            "type": "string",
            "maxLength": 2000,
            "pattern": "^[^\\u0000]*$"
          }
        },
        "required": [
          "pickup",
          "destination",
          "date",
          "passenger_count"
        ],
        "additionalProperties": false,
        "description": "Availability inquiry; always pending human confirmation, no live inventory."
      },
      "check_availabilityResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "pending_human_confirmation",
            "description": "Always pending staff confirmation; no real-time availability is claimed."
          },
          "requires_human_confirmation": {
            "type": "boolean",
            "const": true,
            "description": "Always true; no vehicle has been reserved."
          },
          "note": {
            "type": "string",
            "pattern": "^[^\\u0000]*$",
            "description": "Traditional Chinese pending-availability notice."
          },
          "note_en": {
            "type": "string",
            "pattern": "^[^\\u0000]*$",
            "description": "English pending-availability notice."
          }
        },
        "required": [
          "status",
          "requires_human_confirmation",
          "note",
          "note_en"
        ],
        "additionalProperties": false
      },
      "create_bookingInput": {
        "type": "object",
        "properties": {
          "pickup": {
            "type": "string",
            "minLength": 1,
