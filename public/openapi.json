      "create_bookingResult": {
        "type": "object",
        "properties": {
          "booking_number": {
            "type": "string",
            "pattern": "^[^\\u0000]*$",
            "description": "Request number FY-YYYYMMDD-XXXX, or FY-TEST-… for a test request."
          },
          "status": {
            "type": "string",
            "enum": [
              "pending_review",
              "confirmed",
              "rejected"
            ],
            "description": "Review state; new requests are pending_review. Replays reflect current state."
          },
          "replay": {
            "type": "boolean",
            "description": "True when returning an existing request within the 24-hour idempotency window."
          },
          "is_test": {
            "type": "boolean",
            "description": "Whether the request is explicitly marked as a test."
          },
          "requires_human_confirmation": {
            "type": "boolean",
            "const": true,
            "description": "Always true; staff provide the formal quote and payment link separately."
          },
          "note": {
            "type": "string",
            "pattern": "^[^\\u0000]*$",
            "description": "Traditional Chinese pending-review disclaimer."
          },
          "note_en": {
            "type": "string",
            "pattern": "^[^\\u0000]*$",
            "description": "English pending-review disclaimer."
          }
        },
        "required": [
          "booking_number",
          "status",
          "replay",
          "is_test",
          "requires_human_confirmation",
          "note",
          "note_en"
        ],
        "additionalProperties": false
      }
    }
  }
}
