            "type": "string",
            "maxLength": 2000,
            "pattern": "^[^\\u0000]*$"
          },
          "contact_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[^\\u0000]*$",
            "description": "Traveler or contact name."
          },
          "phone": {
            "type": "string",
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              },
              {
                "pattern": "^\\+?[0-9][0-9 ()-]{6,23}$"
              }
            ],
            "description": "Required contact phone with 8–15 digits; optional leading + and separators."
          },
          "email": {
            "description": "Optional contact email address.",
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "time": {
